# Copy to .env and adjust as needed. docker-compose.yml reads these
# automatically if a .env file is present in the project root.

BENCHLAB_CORS_ORIGINS=*
BENCHLAB_LOG_LEVEL=INFO
BENCHLAB_DOCKER_NETWORK=benchlab-network

# Only needed if you use the openai_compatible provider against the real
# OpenAI API and want to reference it via ${OPENAI_API_KEY} in experiment YAML.
OPENAI_API_KEY=

# Only needed for gated Hugging Face models served via the vllm provider.
HUGGING_FACE_HUB_TOKEN=
